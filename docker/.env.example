# Dokstract environment contract
#
# Copy this file to .env and provide environment-specific values.
# Do not commit .env when it contains passwords, tokens or credentials.
# Keep the variable order and section headings unchanged so local,
# dev, test and production configurations can be compared line-by-line.
# Required variables are enforced by Docker Compose.
# Blank secret values must be replaced before deployment.

# ============================================================
# 01. APP ENVIRONMENT
# ============================================================

APP_ENV=local

# ============================================================
# 02. STABLE SERVICE IDENTITIES
# ============================================================

ENGINE_SERVICE_NAME=dokstract-ocr-engine

# ============================================================
# 03. INTERNAL SERVICE HOSTING
# ============================================================

ENGINE_HOST=0.0.0.0
ENGINE_PORT=8010
ENGINE_HOST_PORT=8010

# ============================================================
# 04. AUTHENTICATION AND INTERNAL SERVICE TOKENS
# ============================================================

OCR_ENGINE_OCR_API_TOKEN=change-me-ocr-api-to-engine
OCR_ENGINE_SCHEMA_API_TOKEN=change-me-schema-api-to-engine
ENGINE_ADMIN_TOKEN=change-me-engine-admin

# ============================================================
# 05. CORS AND PUBLIC ACCESS
# ============================================================

ENGINE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================================
# 06. SERVICE RUNTIME LIMITS AND TIMEOUTS
# ============================================================

OCR_LANG=en
OCR_CPU_THREADS=4
OCR_DET_LIMIT_SIDE_LEN=1536
OCR_TEXT_BATCH_SIZE=2
OCR_MAX_RENDER_DPI=180
OCR_MAX_IMAGE_WIDTH=6000
OCR_MAX_IMAGE_HEIGHT=6000
OCR_MAX_IMAGE_PIXELS=24000000
OCR_MAX_DECODED_IMAGE_BYTES=134217728
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_PDF_PAGES_PER_FILE=100
OCR_MAX_PDF_PAGES_PER_REQUEST=15
OCR_DIGITAL_TEXT_THRESHOLD=200
ENGINE_MAX_INFLIGHT_REQUESTS=2

# ============================================================
# 07. OCR ENGINE INTEGRATION
# ============================================================

ENGINE_REGISTRY_DB_PATH=workspace_tmp/ocr-engine-registry.db
ENGINE_DEFAULT_RELEASE_TAG=ocr-engine-2026.07.15
ENGINE_DEFAULT_IMAGE_DIGEST=sha256:dev-placeholder
ENGINE_DEFAULT_SUPPORTED_API_VERSIONS=v1
ENGINE_DEFAULT_CAPABILITIES=ocr,pdf
