
# Dokstract OCR Engine - Local Environment


# ============================================================
# 01. ENVIRONMENT
# ============================================================

DEPLOY_ENV=local
APP_ENV=${DEPLOY_ENV}

ENGINE_SERVICE_NAME=dokstract-ocr-engine

COMPOSE_PROJECT_NAME=${ENGINE_SERVICE_NAME}-${DEPLOY_ENV}
DOKSTRACT_SHARED_NETWORK=dokstract-shared-${DEPLOY_ENV}

ENV_FILE=.env

ENGINE_HOST=0.0.0.0
ENGINE_PORT=8010


# ============================================================
# 02. TOKENS
# ============================================================

# Service Tokens

# OCR Engine administration
ENGINE_ADMIN_TOKEN=044b0a6db695a6aece75efc45e12ef9fe31c8b861925b6a50eb22b4bf0ede0d5


# Container Communication Tokens

# OCR API <-> OCR Engine
OCR_ENGINE_OCR_API_TOKEN=0e6ef1fb47e1571d4827f6dfd910d386f0aea9d6aef99a56ec6b7257469c14ee

# Schema API <-> OCR Engine
OCR_ENGINE_SCHEMA_API_TOKEN=2a5355d0a82b0bfdc8bb431934775745346740fdba36cbfae2068ea39792ce96

# Teaching Agent <-> OCR Engine
TEACHING_OCR_ENGINE_TOKEN=ea6561effacc53a227f2ca68a3b3ee14dce6662a5cecf5a7d8ca48c17a2a95ab

# Platform API <-> OCR Engine
PLATFORM_API_OCR_ENGINE_TOKEN=e2bfcfd914ac0c64b3a5e0492d644f33df5f618bdc0b3630b110f0556a2ff383


# ============================================================
# 03. COMMUNICATION
# ============================================================

# Platform API
PLATFORM_API_URL=http://platform-api:8000

# CORS
ENGINE_CORS_ORIGINS=*

# Optional secondary network
OCR_ENGINE_ENABLE_SECONDARY_NETWORK=false
OCR_ENGINE_SECONDARY_NETWORK=


# ============================================================
# 04. ENGINE IDENTITY / REGISTRY
# ============================================================

ENGINE_REGISTRY_DB_PATH=/app/.data/ocr-engine-registry.db

ENGINE_DEFAULT_RELEASE_TAG=ocr-engine-2026.07.15
ENGINE_DEFAULT_IMAGE_DIGEST=sha256:dev-placeholder
ENGINE_DEFAULT_SUPPORTED_API_VERSIONS=v1
ENGINE_DEFAULT_CAPABILITIES=ocr,pdf


# ============================================================
# 05. PLATFORM REPORTING
# ============================================================

PLATFORM_REPORTING_ENABLED=true
PLATFORM_REPORTING_REQUEST_TIMEOUT_SECONDS=15

PLATFORM_REPORTING_POLL_INTERVAL_SECONDS=5
PLATFORM_REPORTING_CLAIM_TIMEOUT_SECONDS=30

PLATFORM_REPORTING_RETRY_BASE_DELAY_SECONDS=5
PLATFORM_REPORTING_RETRY_MAX_DELAY_SECONDS=300
PLATFORM_REPORTING_MAX_ATTEMPTS=8

PLATFORM_REPORTING_BATCH_SIZE=20
PLATFORM_REPORTING_DELIVERED_RETENTION_SECONDS=86400


# ============================================================
# 06. OCR RUNTIME
# ============================================================

OCR_LANG=en
OCR_CPU_THREADS=2
OCR_ENABLE_MKLDNN=true
OCR_MAX_CONCURRENCY=2

OCR_DET_LIMIT_SIDE_LEN=1536
OCR_TEXT_BATCH_SIZE=2

OCR_MAX_RENDER_DPI=180
OCR_PDF_RENDER_SCALE=1.4
OCR_LOW_CONTENT_RENDER_SCALE=1.2

OCR_DIGITAL_TEXT_THRESHOLD=200


# ============================================================
# 07. INPUT / FILE LIMITS
# ============================================================

OCR_MAX_IMAGE_WIDTH=6000
OCR_MAX_IMAGE_HEIGHT=6000
OCR_MAX_IMAGE_PIXELS=24000000

OCR_MAX_DECODED_IMAGE_BYTES=134217728
OCR_MAX_UPLOAD_BYTES=52428800

OCR_MAX_PDF_PAGES_PER_FILE=100
OCR_MAX_PDF_PAGES_PER_REQUEST=15


# ============================================================
# 08. IMAGE / PAGE LIMITS
# ============================================================

OCR_MAX_IMAGE_WIDTH_PIXELS=12000
OCR_MAX_IMAGE_HEIGHT_PIXELS=12000
OCR_MAX_IMAGE_TOTAL_PIXELS=80000000

OCR_MAX_TOTAL_RENDERED_PIXELS_PER_REQUEST=300000000
OCR_MAX_PAGE_ASPECT_RATIO=15.0


# ============================================================
# 09. STITCHED PAGE DETECTION
# ============================================================

OCR_STITCHED_PAGE_DETECTION_ENABLED=true
OCR_STITCHED_PAGE_ACTION=reject
OCR_STITCHED_PAGE_ASPECT_SIGNAL_THRESHOLD=4.0
OCR_STITCHED_PAGE_CONFIDENCE_THRESHOLD=0.5


# ============================================================
# 10. TEMPORARY INPUT LIFECYCLE
# ============================================================

OCR_TEMP_ROOT=/tmp/dokstract-ocr
OCR_TEMP_CLEANUP_ENABLED=true
OCR_TEMP_STALE_AFTER_SECONDS=3600


# ============================================================
# 11. OCR RESULT CACHE
# ============================================================

OCR_RESULT_CACHE_ENABLED=true
OCR_RESULT_CACHE_REQUIRED=true
OCR_RESULT_CACHE_TTL_SECONDS=86400
OCR_RESULT_CACHE_KEY_PREFIX=dokstract:ocr:result
OCR_RESULT_CACHE_DIR=/app/.data/ocr-cache


# ============================================================
# 12. IMAGE PROCESSING
# ============================================================

OCR_IMAGE_PROCESSING_DEFAULT_ENABLED=false
OCR_IMAGE_PROCESSING_DEFAULT_PROFILE=none
OCR_IMAGE_PROCESSING_ALLOWED_PROFILES=none,document_standard
OCR_IMAGE_PROCESSING_PIPELINE_VERSION=1


# ============================================================
# 13. DESKEW
# ============================================================

OCR_DESKEW_ENABLED=true
OCR_DESKEW_MIN_CONFIDENCE=0.85
OCR_DESKEW_MAX_ANGLE_DEGREES=10


# ============================================================
# 14. REQUEST GUARD
# ============================================================

OCR_MAX_QUEUED_REQUESTS=50
OCR_QUEUE_WAIT_TIMEOUT_SECONDS=300


# ============================================================
# 15. RENDERING
# ============================================================

OCR_RENDER_DEFAULT_DPI=150
OCR_RENDER_DEFAULT_SCALE=1.5


# ============================================================
# 16. DIGITAL PDF
# ============================================================

OCR_DIGITAL_PDF_FAST_PATH_ENABLED=true
OCR_DIGITAL_PDF_MIN_CHARACTERS=50


# ============================================================
# 17. BLANK PAGE DETECTION
# ============================================================

OCR_BLANK_PAGE_DETECTION_ENABLED=true
OCR_BLANK_PAGE_WHITE_RATIO_THRESHOLD=0.995


# ============================================================
# 18. DEBUGGING
# ============================================================

OCR_DEBUG_DIAGNOSTICS=false
OCR_DEBUG_SAVE_IMAGES=false
OCR_DEBUG_ARTIFACT_DIR=/app/.data/ocr-debug
OCR_DEBUG_RETENTION_HOURS=24


# ============================================================
# 19. LOGGING
# ============================================================

OCR_LOG_PAGE_SUMMARIES=true
OCR_LOG_OCR_TEXT=false
