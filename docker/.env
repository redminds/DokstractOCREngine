# Dokstract runtime environment
#
# Keep this file outside version control when it contains secrets.
# Preserve the section order so it remains comparable with .env.example.

# ============================================================
# 02. STABLE SERVICE IDENTITIES
# ============================================================

ENGINE_SERVICE_NAME=dokstract-ocr-engine

# ============================================================
# 05. INTERNAL CONTAINER PORTS
# ============================================================

ENGINE_PORT=8010

# ============================================================
# 08. AUTHENTICATION AND INTERNAL SERVICE TOKENS
# ============================================================


OCR_ENGINE_OCR_API_TOKEN=SDFGSDRWE44SFGKRET436FDSG45654DFGD@DSG3RSDFSDFG@
OCR_ENGINE_SCHEMA_API_TOKEN=DSGDFGH46SDFFGK5DFG56GDFGHDFGKLHJ@SFDGR56DFRF
ENGINE_ADMIN_TOKEN=DSDFGFD565DFGDFKL5KL;FD@FGSDF5645SDFGDFGHDGLHTONMGLFGS


# ============================================================
# 12. SERVICE RUNTIME LIMITS AND TIMEOUTS
# ============================================================

OCR_LANG=en
OCR_CPU_THREADS=4
OCR_MAX_CONCURRENCY=2
OCR_DET_LIMIT_SIDE_LEN=1536
OCR_TEXT_BATCH_SIZE=2
OCR_MAX_RENDER_DPI=180
OCR_MAX_IMAGE_WIDTH=6000
OCR_MAX_IMAGE_HEIGHT=6000
OCR_MAX_IMAGE_PIXELS=24000000
OCR_MAX_DECODED_IMAGE_BYTES=134217728
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_PDF_PAGES_PER_FILE=100
OCR_MAX_PDF_PAGES_PER_REQUEST=15
OCR_DIGITAL_TEXT_THRESHOLD=200


# ============================================================
# 13. OCR ENGINE INTEGRATION
# ============================================================

ENGINE_REGISTRY_DB_PATH=workspace_tmp/ocr-engine-registry.db
ENGINE_DEFAULT_RELEASE_TAG=ocr-engine-2026.07.15
ENGINE_DEFAULT_IMAGE_DIGEST=sha256:dev-placeholder
ENGINE_DEFAULT_SUPPORTED_API_VERSIONS=v1
ENGINE_DEFAULT_CAPABILITIES=ocr,pdf


ENGINE_HEALTH_WAIT_TIMEOUT_SECONDS=600
ENGINE_HEALTH_START_PERIOD_SECONDS=600
ENGINE_HEALTH_INTERVAL_SECONDS=5
ENGINE_HEALTH_TIMEOUT_SECONDS=10
ENGINE_HEALTH_RETRIES=12

# ============================================================
# 18. OPTIONAL INTEGRATIONS
# ============================================================

ENGINE_HOST=0.0.0.0
ENGINE_HOST_PORT=8010
